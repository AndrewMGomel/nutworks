{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NUTS Review Findings",
  "description": "Shared structured output for NUTS Critique, Review, Concerns, and Verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "target_kind",
    "findings",
    "residual_risks",
    "deferred_questions",
    "testing_gaps"
  ],
  "properties": {
    "reviewer": {
      "type": "string",
      "enum": [
        "coherence",
        "feasibility",
        "correctness",
        "testing",
        "change-risk",
        "simplicity",
        "audit-concerns",
        "audit-verification"
      ],
      "description": "Exact bundled bench or audit producer identity"
    },
    "target_kind": {
      "type": "string",
      "enum": ["document", "code"],
      "description": "Assignment-level document or code kind represented by this finding"
    },
    "findings": {
      "type": "array",
      "description": "Actionable findings in this return; an empty array alone does not satisfy a pass seat or establish convergence",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "location",
          "why_it_matters",
          "finding_type",
          "confidence",
          "evidence",
          "requires_verification",
          "pre_existing"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Short, specific issue title"
          },
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "location": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "section"],
                "properties": {
                  "kind": {"const": "document"},
                  "section": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path", "line"],
                "properties": {
                  "kind": {"const": "code"},
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Repository-relative path"
                  },
                  "line": {"type": "integer", "minimum": 1}
                }
              }
            ]
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1,
            "description": "Concrete impact or failure mode"
          },
          "finding_type": {
            "type": "string",
            "enum": ["error", "omission"]
          },
          "suggested_fix": {
            "type": ["string", "null"],
            "description": "Untrusted suggestion for the main runner; never mutation authority"
          },
          "confidence": {
            "type": "integer",
            "enum": [0, 25, 50, 75, 100]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "requires_verification": {"type": "boolean"},
          "pre_existing": {"type": "boolean"}
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deferred_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "testing_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "review_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_ref", "protocol_complete", "limitations"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["complete_protocol", "targeted_verification"]
        },
        "target_ref": {"type": "string", "minLength": 1},
        "protocol_complete": {"type": "boolean"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "complete_protocol"}}},
          "then": {
            "properties": {
              "protocol_complete": {"const": true},
              "limitations": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "targeted_verification"}}},
          "then": {
            "properties": {
              "protocol_complete": {"const": false},
              "limitations": {"minItems": 1}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewer": {
            "enum": [
              "coherence",
              "feasibility",
              "correctness",
              "testing",
              "change-risk",
              "simplicity"
            ]
          }
        }
      },
      "then": {"required": ["review_receipt"]}
    },
    {
      "if": {
        "properties": {
          "reviewer": {"enum": ["audit-concerns", "audit-verification"]}
        }
      },
      "then": {"not": {"required": ["review_receipt"]}}
    }
  ]
}
